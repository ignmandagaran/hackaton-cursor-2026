{
  "name": "nextjs-starter",
  "description": "A modern Next.js starter template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "scripts": {
    "analyze": "cross-env ANALYZE=true bun run build",
    "analyze:experimental": "next experimental-analyze",
    "build": "next build",
    "dev": "next dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "dev:https": "bun ./lib/scripts/dev.ts --https",
    "dev:inspect": "bun ./lib/scripts/dev.ts --inspect",
    "format": "biome format --write .",
    "lighthouse": "bunx @unlighthouse/cli --site http://localhost:3000",
    "lint": "biome lint --max-diagnostics=200",
    "lint:fix": "biome lint --write --unsafe --max-diagnostics=200",
    "start": "next start",
    "typecheck": "tsgo --noEmit",
    "typecheck:compare": "bun run typecheck:tsc && bun run typecheck",
    "typecheck:tsc": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@phosphor-icons/react": "^2.1.10",
    "ai": "^7.0.77",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@next/bundle-analyzer": "^16.2.6",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "postcss-preset-env": "^11.3.0",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ]
}
